# ============================================================
# Ivy Homes Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

# --- Ivy Homes API ---
IVY_API_KEY=                        # IVY26-XXXXXXXXXXXXXXXX
IVY_BASE_URL=https://solve.ivy.homes

# --- MongoDB ---
MONGODB_URI=                        # mongodb+srv://user:pass@cluster.mongodb.net/ivyhomes

# --- Server ---
PORT=4000
NODE_ENV=development                # development | production

# --- Cookie Security ---
# In production: set to your deployed frontend origin
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECRET=                      # random 32-char string, e.g. openssl rand -hex 32

# --- Ivy Demo Accounts (for testing only, not exposed to client) ---
# Password shared across all demo accounts
IVY_DEMO_PASSWORD=                  # provided in registration email
